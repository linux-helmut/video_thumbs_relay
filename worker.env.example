# Copy this file to worker.env and fill in your own values.
# Do not commit worker.env: it contains credentials.

# WebDAV URL ending in /remote.php/dav/files/<username>/
NC_URL=https://cloud.example.com/remote.php/dav/files/USERNAME/
NC_USER=YOUR_NEXTCLOUD_USERNAME
NC_PASS=YOUR_NEXTCLOUD_APP_PASSWORD
NC_SECRET=YOUR_VIDEO_THUMBNAIL_RELAY_SECRET
NC_STRICT_TLS=true

# Days to skip rescanning an unchanged folder
SCAN_INTERVAL_DAYS=7

# Local paths (overridden by compose.yml to /data/...)
TEMP_DIR=./tmp_thumbs
FOLDER_CACHE=./folder_cache.csv
THUMB_CACHE=./thumb_cache.csv
FAIL_CACHE=./fail_cache.csv

# Performance
# Empty means CPU cores - 1
FFMPEG_THREADS=
IO_CONCURRENCY=4
MAX_VIDEO_SIZE_MB=4000

# Comma-separated Nextcloud folders to scan
# Set these to folders that exist in your account.
SCAN_PATHS=/Photo,/SmartPhone_Upload,/User_Pics
